# .env.example
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/swim_ai_db

# Variables Docker
POSTGRES_PASSWORD=motdepasse
GRAFANA_PASSWORD=motdepasse

# Clé JWT — générer avec : openssl rand -hex 32
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE

# Environnement : "development" ou "production"
# En production, SECRET_KEY par défaut bloque le démarrage
ENVIRONMENT=development