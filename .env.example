# .env.example
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/swim_ai_db

# Variables Docker
POSTGRES_PASSWORD=motdepasse
GRAFANA_PASSWORD=motdepasse

# Clé JWT — générer avec : openssl rand -hex 32
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE

# Environnement : "development" ou "production"
# En production, SECRET_KEY par défaut bloque le démarrage
ENVIRONMENT=development

# ─── Email — réinitialisation de mot de passe ───────────────────────────────
# Gmail SMTP : utiliser un MOT DE PASSE D'APPLICATION, pas votre vrai mot de passe
# Pour générer un mot de passe d'application :
#   1. Compte Google → Sécurité → Validation en 2 étapes (activer si pas fait)
#   2. Compte Google → Sécurité → Mots de passe des applications
#   3. Sélectionner "Messagerie" → Générer → Copier les 16 caractères
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# URL du frontend — utilisée dans le lien de réinitialisation envoyé par email
FRONTEND_URL=http://localhost:3000